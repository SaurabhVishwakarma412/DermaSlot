# ==========================================
# Docker Compose Environment Configuration
# ==========================================
BACKEND_IMAGE=saurabhkv/project-pedo-backend:latest
FRONTEND_IMAGE=saurabhkv/project-pedo-frontend:latest

# Port Mappings
BACKEND_PORT=5000
FRONTEND_PORT=5173
MONGO_PORT=27017
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# Backend Database & Secrets
MONGO_URI=mongodb://mongo:27017/dermaslot
JWT_SECRET=replace-with-a-secure-jwt-secret
FRONTEND_URL=http://localhost:5173,http://localhost:80

# Cloudinary Image Uploads (Optional)
CLOUD_NAME=
API_KEY=
API_SECRET=

# SMTP / Email Notifications (Optional)
EMAIL_USER=
EMAIL_PASS=

# Grafana Dashboard Admin Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
