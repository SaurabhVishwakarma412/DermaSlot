      "targets": [
        {
          "expr": "nodejs_memory_heap_used_bytes{job=\"pedoderma-backend\"} / 1024 / 1024",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "nodejs_memory_heap_total_bytes{job=\"pedoderma-backend\"} / 1024 / 1024",
          "legendFormat": "Heap Total",
          "refId": "B"
        },
        {
          "expr": "nodejs_memory_rss_bytes{job=\"pedoderma-backend\"} / 1024 / 1024",
          "legendFormat": "RSS",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "HTTP Request Volume by Route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route, status) (rate(pedoderma_http_requests_total{job=\"pedoderma-backend\"}[1m]))",
          "legendFormat": "{{route}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
