# ==========================================
# PedoDerma Environment Variables Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==========================================

# Application Secrets
JWT_SECRET=replace_with_a_long_random_secret

# MongoDB Connection (Local or Atlas)
# For local Docker: mongodb://mongo:27017/dermaslot
# For Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>
MONGO_URI=mongodb://mongo:27017/dermaslot

# Port Mappings
BACKEND_PORT=5000
FRONTEND_PORT=5173
MONGO_PORT=27017
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# Frontend URLs & CORS
FRONTEND_URL=http://localhost:5173,http://localhost:80
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

