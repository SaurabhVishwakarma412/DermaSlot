# ==========================================
# SECRETS & ENVIRONMENT FILES (NEVER PUSH)
# ==========================================
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
.env
*/.env
*/.env.*
!*.env.example
!*/.env.example
!*.env.docker.example

# Kubernetes secret manifests
*secret*.yaml
*secrets*.yaml
!*secret*.template.yaml
!*secrets*.template.yaml
!*secret*.example.yaml

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*.pub
*.token

# Cloud & Service Account Credentials
credentials.json
service-account*.json
client_secret*.json

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# BUILD OUTPUTS & CACHES
# ==========================================
dist/
*/dist/
build/
*/build/
.next/
.cache/
*.tsbuildinfo

# ==========================================
# UPLOADED USER / PATIENT MEDICAL DATA
# ==========================================
uploads/
*/uploads/
*/src/uploads/
!uploads/.gitkeep
!*/uploads/.gitkeep
!*/src/uploads/.gitkeep

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# DATABASE DUMPS & LOCAL VOLUMES
# ==========================================
*.sqlite
*.sqlite3
*.db
mongo-data/
dump/

# ==========================================
# OS & IDE METADATA
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
